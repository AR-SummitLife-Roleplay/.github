root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Enforce Script: tabs, as in Bohemia's own formatter
[*.c]
indent_style = tab

# Files Workbench writes itself: leave them as Workbench saves them
[*.{et,ent,conf,layout,meta,emat,gproj}]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,bat,cmd}]
end_of_line = crlf
